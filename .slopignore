# Trees this repository does not author, so the linter has nothing to say
# about them. data/ and the dist trees are inputs and build output, and the
# context folder carries Hive Workshop reference docs.
data/
dist/
dist.old/
dist-mcp/
dist-mcp.old/
dist-studio/
src/Wc3.Mcp/context/

# Captured output, not prose anyone wrote. Test run logs, a generated command
# reference the CI guard regenerates, and saved tool dumps under docs/.
uabi-disconnect/results/
docs/wc3ctl-command-reference.md
docs/bvo15-level-gap-repair.txt

# Vendored licence text. The licence clause "subject to the following
# conditions" is quoted from Apache and Mozilla and must not be reworded.
THIRD-PARTY-NOTICES.md

# Agent work logs and captured diffs. A progress report records what ran on a
# day, and rewriting its words would falsify the record.
.superpowers/
.loop/

# Captured diff output from the 3.0.0 evidence sweep.
docs/reforged-3.0.0-evidence/*.txt
docs/reforged-3.0.0-findings.txt

# Generated by wc3ctl docs all. Editing it by hand is pointless, the next run
# overwrites the prose.
docs/mcp-reference.md

