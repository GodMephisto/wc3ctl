<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Wc3.Studio.Controls.CatalogEditorView">
    <Grid>
        <!-- Empty-state / error line (see ShowHint). -->
        <TextBlock Name="PlaceholderText"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   TextWrapping="Wrap" TextAlignment="Center" Margin="24"
                   Text="No map open"/>

        <DockPanel Name="ContentRoot" IsVisible="False">
            <!-- Title + one-line subtitle. -->
            <Border DockPanel.Dock="Top" BorderBrush="#33555555"
                    BorderThickness="0,0,0,1" Padding="8,6">
                <StackPanel Spacing="2">
                    <TextBlock Name="TitleText" FontWeight="SemiBold"/>
                    <TextBlock Name="SubtitleText" FontSize="11" Foreground="#8FA3B8"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- The owning panel drops its "add new" form here. -->
            <Border DockPanel.Dock="Top" Name="AddBorder" BorderBrush="#33555555"
                    BorderThickness="0,0,0,1" Padding="8,6">
                <ContentControl Name="AddHost"/>
            </Border>

            <!-- Status / last-action line. -->
            <Border DockPanel.Dock="Bottom" BorderBrush="#33555555"
                    BorderThickness="0,1,0,0" Padding="8,4">
                <TextBlock Name="StatusText" TextWrapping="Wrap" Text=""/>
            </Border>

            <!-- One card per catalog entry, built in code by the owning panel (no
                 virtualization, so editable controls never hit the recycling pitfall). -->
            <Panel>
                <ScrollViewer Name="ItemScroll">
                    <StackPanel Name="ItemHost" Margin="8" Spacing="8"/>
                </ScrollViewer>

                <!-- Empty state, shown INSTEAD of the (empty) card list. It lives here, in
                     the card region, because that is where the eye goes. The four catalog
                     panels used to announce "this map has no regions yet" on the bottom
                     status line, a small grey footnote under a tall blank area, which reads
                     as a panel that failed rather than a map with nothing in it. -->
                <StackPanel Name="EmptyState" IsVisible="False" Spacing="6" Margin="32"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Name="EmptyTitle" FontSize="14" FontWeight="SemiBold"
                               Foreground="#B8C6D6" TextAlignment="Center"
                               TextWrapping="Wrap"/>
                    <TextBlock Name="EmptyHint" FontSize="12" Foreground="#7F93A8"
                               TextAlignment="Center" TextWrapping="Wrap" MaxWidth="380"/>
                </StackPanel>
            </Panel>
        </DockPanel>
    </Grid>
</UserControl>
