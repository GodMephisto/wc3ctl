<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ae="using:AvaloniaEdit"
             x:Class="Wc3.Studio.Controls.JassEditorView">
    <Grid RowDefinitions="*,Auto">

        <!-- The editor. Line numbers, JASS highlighting and Ctrl+F search are wired in
             code-behind so the highlighting can be built from the shared vocabulary. -->
        <ae:TextEditor Name="Editor" Grid.Row="0"
                       ShowLineNumbers="True"
                       FontFamily="Cascadia Mono,Consolas,Menlo,monospace"
                       FontSize="13"
                       HorizontalScrollBarVisibility="Auto"
                       VerticalScrollBarVisibility="Auto"/>

        <!-- Problems found in the shown source. Hidden when there are none, so a clean
             script costs no vertical space. Clicking a row jumps to its line. -->
        <Border Grid.Row="1" Name="ProblemsBorder" IsVisible="False"
                BorderBrush="#33555555" BorderThickness="0,1,0,0"
                Background="#1A2A1010" MaxHeight="132">
            <ScrollViewer>
                <ItemsControl Name="ProblemsList" Margin="6,4">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Classes="problem" HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Left"
                                    Background="Transparent" BorderThickness="0"
                                    Padding="4,2" Command="{Binding Jump}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="{Binding Badge}" FontSize="11"
                                               FontWeight="SemiBold" MinWidth="52"
                                               Foreground="{Binding Accent}"/>
                                    <TextBlock Text="{Binding Where}" FontSize="11"
                                               MinWidth="64" Foreground="#8FA3B8"
                                               FontFamily="Cascadia Mono,Consolas,monospace"/>
                                    <TextBlock Text="{Binding Message}" FontSize="11"
                                               TextWrapping="Wrap" Foreground="#D6DEE8"/>
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
