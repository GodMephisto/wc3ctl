<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Wc3.Studio.Controls.OwnerTeamPicker">
    <UserControl.Styles>
        <!-- Team/neutral group headers inside the owner dropdown are display-only:
             disabling the container keeps them unselectable (same idiom as the
             Object editor's reference sub-rows). -->
        <Style Selector="ComboBox#OwnerCombo ComboBoxItem">
            <Setter Property="IsEnabled" Value="{Binding !IsHeader}"/>
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="MinHeight" Value="0"/>
        </Style>
    </UserControl.Styles>

    <!-- Players grouped under their team, neutrals last; each row carries the slot's
         color swatch (see BuildOwnerItems in code-behind). -->
    <ComboBox Name="OwnerCombo" MaxDropDownHeight="420"
              HorizontalAlignment="Stretch"
              SelectionChanged="OnComboSelectionChanged">
        <ComboBox.ItemTemplate>
            <DataTemplate>
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <Border Width="12" Height="12" CornerRadius="2"
                            VerticalAlignment="Center"
                            Background="{Binding Swatch}"
                            IsVisible="{Binding !IsHeader}"/>
                    <TextBlock Text="{Binding Label}"
                               FontWeight="{Binding Weight}"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </DataTemplate>
        </ComboBox.ItemTemplate>
    </ComboBox>
</UserControl>
