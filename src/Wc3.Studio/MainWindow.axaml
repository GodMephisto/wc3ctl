<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Wc3.Studio.MainWindow"
        Title="wc3ctl Studio"
        Width="800" Height="600">
    <DockPanel Margin="12">

        <!-- Path input + Open -->
        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto,Auto" Margin="0,0,0,8">
            <TextBox Grid.Column="0" Name="PathBox"
                     Watermark="Path to a .w3x / .w3m map file"
                     Margin="0,0,8,0"/>
            <Button Grid.Column="1" Name="BrowseButton" Content="Browse…"
                    Margin="0,0,8,0" Click="OnBrowseClick"/>
            <Button Grid.Column="2" Name="OpenButton" Content="Open"
                    Click="OnOpenClick"/>
        </Grid>

        <!-- Status -->
        <TextBlock DockPanel.Dock="Bottom" Name="StatusText"
                   Margin="0,8,0,0" TextWrapping="Wrap"/>

        <!-- Map info -->
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8" Spacing="2">
            <TextBlock Name="NameText" FontSize="18" FontWeight="Bold"/>
            <TextBlock Name="AuthorText"/>
            <TextBlock Name="PlayersText"/>
            <TextBlock Name="SizeText"/>
        </StackPanel>

        <!-- File list -->
        <ListBox Name="FileList">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid ColumnDefinitions="*,90,70,70">
                        <TextBlock Grid.Column="0" Text="{Binding Name}"/>
                        <TextBlock Grid.Column="1" Text="{Binding Size}" HorizontalAlignment="Right"/>
                        <TextBlock Grid.Column="2" Text="{Binding Known}" HorizontalAlignment="Right"/>
                        <TextBlock Grid.Column="3" Text="{Binding Parsed}" HorizontalAlignment="Right"/>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

    </DockPanel>
</Window>
