<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:panels="using:Wc3.Studio.Panels"
        x:Class="Wc3.Studio.MainWindow"
        Title="wc3ctl Studio"
        Width="1600" Height="900">
    <DockPanel>

        <!-- Top menu -->
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="Open _Source Map…" Click="OnOpenSourceMapClick"/>
                <MenuItem Header="Open _Target Map…" Click="OnOpenTargetMapClick"/>
                <Separator/>
                <MenuItem Header="E_xit" Click="OnExitClick"/>
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="_About" Click="OnAboutClick"/>
            </MenuItem>
        </Menu>

        <!-- Bottom status bar -->
        <Border DockPanel.Dock="Bottom" BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                Padding="8,4">
            <TextBlock Name="StatusText" TextWrapping="Wrap"
                       Text="Open a source map (port from) and a target map (port into)."/>
        </Border>

        <!-- Center: two fully independent map workspaces, source | target. The Target pane
             starts hidden (columns 1 and 2 collapsed to 0 width) so a single map fills the
             window; it is revealed by RevealTargetPane on Open Target / Port. -->
        <Grid Name="PanesGrid" ColumnDefinitions="*,0,0">
            <panels:MapWorkspaceView Grid.Column="0" Name="SourceWorkspace" Role="Source"/>
            <GridSplitter Grid.Column="1" Name="PaneSplitter" Width="4" ResizeDirection="Columns"
                          Background="#33555555" IsVisible="False"/>
            <panels:MapWorkspaceView Grid.Column="2" Name="TargetWorkspace" Role="Target"
                                     IsVisible="False"/>
        </Grid>

    </DockPanel>
</Window>
