<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:panels="using:Wc3.Studio.Panels"
        x:Class="Wc3.Studio.MainWindow"
        Title="wc3ctl Studio"
        Width="1200" Height="800">
    <DockPanel>

        <!-- Top menu -->
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="_Open Map…" Click="OnOpenMapClick"/>
                <Separator/>
                <MenuItem Header="E_xit" Click="OnExitClick"/>
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="_About" Click="OnAboutClick"/>
            </MenuItem>
        </Menu>

        <!-- Bottom status bar -->
        <Border DockPanel.Dock="Bottom" BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                Padding="8,4">
            <TextBlock Name="StatusText" Text="No map open." TextWrapping="Wrap"/>
        </Border>

        <!-- Center: the map workspace (session + panel tabs) -->
        <panels:MapWorkspaceView Name="Workspace" Role="Map"/>

    </DockPanel>
</Window>
