<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:Wc3.Studio.Controls"
             x:Class="Wc3.Studio.Panels.DependencyGraphView">
    <UserControl.Styles>
        <!-- Compact tree rows; counts here are small (dozens), no virtualization concerns. -->
        <Style Selector="TreeView#DepTree TreeViewItem">
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Padding" Value="2,1"/>
        </Style>
        <Style Selector="Expander /template/ ToggleButton">
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Padding" Value="8,4"/>
        </Style>
        <!-- Compact zoom toolbar overlaid on the graph's top-right corner. -->
        <Style Selector="StackPanel#ZoomBar > Button">
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="MinWidth" Value="28"/>
            <Setter Property="Padding" Value="7,2"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>
    </UserControl.Styles>

    <Grid>
        <TextBlock Name="PlaceholderText"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   Text="Dependency panel - no map open"/>

        <Grid Name="ContentRoot" IsVisible="False" RowDefinitions="Auto,*,Auto">

            <!-- Object picker (follows the Objects tab's kind) + closure summary -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="6,4">
                <TextBlock Name="KindLabel" Text="Unit:" VerticalAlignment="Center"/>
                <controls:SearchableComboBox Name="ObjectCombo" MinWidth="280"/>
                <CheckBox Name="HideCarriedCheck" IsChecked="False" IsVisible="False"
                          VerticalAlignment="Center"
                          Content="Show objects carried by the script closure"
                          ToolTip.Tip="Uncheck to hide the objects the trigger script drags in (other heroes' kits), in both the tree and the graph. This only changes the view, it never changes what gets ported."/>
                <TextBlock Name="SummaryText" VerticalAlignment="Center"
                           Foreground="#8FA3B8" Text=""/>
            </StackPanel>

            <Grid Grid.Row="1" ColumnDefinitions="*,4,360">

                <!-- Primary: layered node-link graph (objects in depth columns,
                     files in a bottom band) on an interactive canvas - drag empty
                     space to pan, wheel to zoom about the cursor, drag a node to
                     move it (its edges follow). The viewport clips; pan/zoom
                     replace scrollbars. -->
                <Grid Grid.Column="0">
                    <Border Name="GraphViewport" ClipToBounds="True" Background="#14000000">
                        <Canvas Name="GraphCanvas"
                                HorizontalAlignment="Left" VerticalAlignment="Top"/>
                    </Border>
                    <TextBlock Name="GraphHint"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="#8FA3B8" TextWrapping="Wrap" Margin="24"
                               IsHitTestVisible="False"
                               Text="Pick an object to see its dependency graph."/>
                    <StackPanel Name="ZoomBar" Orientation="Horizontal" Spacing="4"
                                HorizontalAlignment="Right" VerticalAlignment="Top"
                                Margin="0,8,12,0">
                        <TextBlock Name="ZoomLabel" Text="100%" FontSize="11"
                                   Foreground="#8FA3B8" VerticalAlignment="Center"
                                   Margin="0,0,4,0"/>
                        <Button Name="ZoomOutButton" Content="-" ToolTip.Tip="Zoom out"/>
                        <Button Name="ZoomInButton" Content="+" ToolTip.Tip="Zoom in"/>
                        <Button Name="ZoomFitButton" Content="Fit" ToolTip.Tip="Fit the whole graph in view"/>
                        <Button Name="ZoomResetButton" Content="Reset" ToolTip.Tip="Back to 100%, origin top-left"/>
                    </StackPanel>
                </Grid>

                <GridSplitter Grid.Column="1" Background="#33555555"/>

                <!-- Secondary: structured details - always readable even when
                     the canvas is busy. -->
                <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="6,2,6,6" Spacing="6">
                        <TreeView Name="DepTree"/>
                        <Expander Name="FilesExpander" Header="Files (0)">
                            <StackPanel Name="FilesList" Spacing="2" Margin="4"/>
                        </Expander>
                        <Expander Name="PortAssetsExpander" Header="Port assets (0)" IsExpanded="False">
                            <StackPanel Name="PortAssetsList" Spacing="2" Margin="4"/>
                        </Expander>
                        <Expander Name="StringsExpander" Header="Strings (0)">
                            <StackPanel Name="StringsList" Spacing="2" Margin="4"/>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- Unobtrusive status line: resolver diagnostics / errors. -->
            <Border Grid.Row="2" BorderBrush="#33555555" BorderThickness="0,1,0,0" Padding="6,4">
                <TextBlock Name="StatusText" TextWrapping="Wrap" FontSize="11" Text=""/>
            </Border>
        </Grid>
    </Grid>
</UserControl>
