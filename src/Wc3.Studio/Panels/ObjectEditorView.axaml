<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Wc3.Studio.Panels.ObjectEditorView">
    <UserControl.Styles>
        <Style Selector="ListBox#ObjectList ListBoxItem">
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="MinHeight" Value="0"/>
        </Style>
        <Style Selector="ListBox#FieldList ListBoxItem">
            <Setter Property="Padding" Value="4,1"/>
            <Setter Property="MinHeight" Value="0"/>
        </Style>
    </UserControl.Styles>

    <Grid>
        <TextBlock Name="PlaceholderText"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   Text="Object editor panel - no map open"/>

        <Grid Name="ContentRoot" IsVisible="False" RowDefinitions="Auto,*,Auto">
            <!-- Type switcher: all 7 Object Editor kinds. New… derives a fresh
                 custom object of the current kind from the selected object. -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="6,4">
                <TextBlock Text="Type:" VerticalAlignment="Center"/>
                <ComboBox Name="KindCombo" MinWidth="150" SelectionChanged="OnKindChanged"/>
                <Button Name="NewObjectButton" Content="New…" Click="OnNewObjectClick"
                        ToolTip.Tip="Create a new custom object of this kind based on the selected one"/>
                <TextBlock Name="ListCountText" VerticalAlignment="Center"
                           Foreground="#8FA3B8" Text=""/>
            </StackPanel>

            <Grid Grid.Row="1" ColumnDefinitions="300,4,*">
                <!-- Master: search + the map's objects of the selected kind (multi-select). -->
                <Grid Grid.Column="0" RowDefinitions="Auto,*,Auto">
                    <TextBox Grid.Row="0" Name="SearchBox" Margin="4,0,4,4"
                             Watermark="Search name or rawcode…"
                             TextChanged="OnSearchChanged"/>
                    <Grid Grid.Row="1">
                        <ListBox Name="ObjectList" SelectionMode="Multiple"
                                 SelectionChanged="OnObjectSelectionChanged"
                                 DoubleTapped="OnObjectDoubleTapped">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Display}"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center"/>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock Name="EmptyListText" IsVisible="False"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   TextWrapping="Wrap" Margin="12" Foreground="#8FA3B8"/>
                    </Grid>
                    <!-- Model preview of the double-clicked object: map-imported
                         models render in-window (drag the image to orbit the
                         camera); base-game models only show their path. -->
                    <Border Grid.Row="2" Name="ModelArea" IsVisible="False"
                            BorderBrush="#33555555" BorderThickness="0,1,0,0" Padding="4">
                        <StackPanel Spacing="4">
                            <TextBlock Name="ModelText" TextWrapping="Wrap" FontSize="11"/>
                            <Border Name="PreviewBorder" IsVisible="False" Height="240"
                                    Background="#22000000" ClipToBounds="True"
                                    Cursor="Hand"
                                    PointerPressed="OnPreviewPointerPressed"
                                    PointerMoved="OnPreviewPointerMoved"
                                    PointerReleased="OnPreviewPointerReleased"
                                    PointerWheelChanged="OnPreviewWheel">
                                <Image Name="PreviewImage" Stretch="Uniform"/>
                            </Border>
                            <TextBlock Name="PreviewHint" IsVisible="False" FontSize="11"
                                       Foreground="#8FA3B8" Text="Drag to rotate, scroll to zoom"/>
                            <Button Name="ExtractModelButton" Content="Extract model…"
                                    IsEnabled="False" Click="OnExtractModelClick"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <GridSplitter Grid.Column="1" Background="#33555555"/>

                <!-- Detail: merged fields (base ⊕ map) of the first selected object,
                     read-only grid + a dedicated editor box below. -->
                <DockPanel Grid.Column="2" Margin="4,0,0,0">
                    <TextBlock Name="SelectedHeader" DockPanel.Dock="Top"
                               FontWeight="SemiBold" Margin="6,4" Text=""/>
                    <TextBlock Name="MultiSelectNote" DockPanel.Dock="Top" IsVisible="False"
                               Foreground="#E8C56A" Margin="6,0,6,4" Text=""/>
                    <Grid DockPanel.Dock="Top" ColumnDefinitions="230,56,*,72" Margin="8,2">
                        <TextBlock Grid.Column="0" Text="Field" FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="1" Text="Code" FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="2" Text="Value" FontWeight="SemiBold" Margin="4,0"/>
                        <TextBlock Grid.Column="3" Text="Source" FontWeight="SemiBold"/>
                    </Grid>

                    <!-- Dedicated field editor: select a row above, edit here, Apply
                         writes to every selected object of the current kind. -->
                    <Border DockPanel.Dock="Bottom" BorderBrush="#33555555"
                            BorderThickness="0,1,0,0" Padding="6,4">
                        <StackPanel Spacing="4">
                            <TextBlock Name="FieldEditLabel" FontWeight="SemiBold"
                                       Text="Select a field to edit"/>
                            <DockPanel>
                                <Button Name="ApplyButton" DockPanel.Dock="Right"
                                        Content="Apply" Margin="6,0,0,0"
                                        IsEnabled="False" Click="OnApplyClick"/>
                                <TextBox Name="EditorBox" MinHeight="0" Padding="4,3"/>
                            </DockPanel>
                            <TextBlock Name="EditNote" Foreground="#8FA3B8" FontSize="11"
                                       TextWrapping="Wrap" Text=""/>
                        </StackPanel>
                    </Border>

                    <ListBox Name="FieldList" SelectionChanged="OnFieldSelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="230,56,*,72">
                                    <TextBlock Grid.Column="0" Text="{Binding Name}"
                                               Foreground="{Binding RowBrush}"
                                               FontWeight="{Binding RowWeight}"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Code}"
                                               FontFamily="Consolas,Menlo,monospace"
                                               Foreground="{Binding RowBrush}"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Value}"
                                               Foreground="{Binding RowBrush}"
                                               FontWeight="{Binding RowWeight}"
                                               TextTrimming="CharacterEllipsis"
                                               Margin="4,0" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="3" Text="{Binding Source}"
                                               Foreground="{Binding RowBrush}"
                                               FontWeight="{Binding RowWeight}"
                                               VerticalAlignment="Center"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Grid>

            <DockPanel Grid.Row="2" Margin="6,4">
                <Button Name="SaveEditsButton" DockPanel.Dock="Right"
                        Content="Save Edits" Click="OnSaveEditsClick"/>
                <TextBlock Name="StatusText" TextWrapping="Wrap"
                           VerticalAlignment="Center" Margin="0,0,8,0" Text=""/>
            </DockPanel>
        </Grid>
    </Grid>
</UserControl>
