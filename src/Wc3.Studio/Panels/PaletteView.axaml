<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Wc3.Studio.Panels.PaletteView">
    <Grid>

        <!-- Shown until a map is open. -->
        <TextBlock Name="PlaceholderText" Margin="8,6"
                   VerticalAlignment="Top" TextWrapping="Wrap"
                   Text="Palette - no map open"/>

        <!-- Search + kind filter over the placeable unit and doodad catalogs. -->
        <Grid Name="ContentRoot" IsVisible="False" RowDefinitions="Auto,Auto,*">

            <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="8,6,8,0">
                <TextBox Name="SearchBox" Grid.Column="0"
                         Watermark="Search name or rawcode…"
                         TextChanged="OnSearchChanged"/>
                <ComboBox Name="KindFilter" Grid.Column="1" Margin="6,0,0,0"
                          SelectedIndex="0" SelectionChanged="OnKindChanged"
                          ToolTip.Tip="Filter by placeable kind.">
                    <ComboBoxItem>All</ComboBoxItem>
                    <ComboBoxItem>Units</ComboBoxItem>
                    <ComboBoxItem>Doodads</ComboBoxItem>
                </ComboBox>
            </Grid>

            <TextBlock Name="StatusText" Grid.Row="1" Margin="8,4"
                       FontSize="11" TextWrapping="Wrap" Text=""/>

            <!-- The selected row is the placement source for the Terrain tab's click-to-place. -->
            <ListBox Name="PaletteList" Grid.Row="2" Margin="8,0,8,8"
                     SelectionChanged="OnSelectionChanged">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="{Binding Display}"
                                       FontFamily="Consolas,Cascadia Mono,Menlo,monospace"/>
                            <TextBlock Text="{Binding Detail}" FontSize="11"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

        </Grid>
    </Grid>
</UserControl>
