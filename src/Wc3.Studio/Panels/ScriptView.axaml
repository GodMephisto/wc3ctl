<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Wc3.Studio.Panels.ScriptView">
    <Grid RowDefinitions="Auto,*">

        <!-- Header: "<N> functions in <file>" -->
        <TextBlock Name="HeaderText" Grid.Row="0" Margin="8,6"
                   FontWeight="SemiBold" Text="No script in map"/>

        <Grid Grid.Row="1" ColumnDefinitions="280,4,*">

            <!-- Left: search + function list -->
            <Grid Grid.Column="0" RowDefinitions="Auto,*" Margin="8,0,0,8">
                <TextBox Name="SearchBox" Grid.Row="0" Margin="0,0,0,6"
                         Watermark="Filter functions…"/>
                <ListBox Name="FunctionList" Grid.Row="1"/>
            </Grid>

            <GridSplitter Grid.Column="1" ResizeDirection="Columns" Background="Transparent"/>

            <!-- Right: selected signature + read-only source view -->
            <Grid Grid.Column="2" RowDefinitions="Auto,*" Margin="0,0,8,8">
                <TextBlock Name="SignatureText" Grid.Row="0" Margin="0,0,0,6"
                           FontFamily="Consolas,Cascadia Mono,Menlo,monospace"
                           TextTrimming="CharacterEllipsis"/>
                <TextBox Name="SourceBox" Grid.Row="1"
                         IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
                         FontFamily="Consolas,Cascadia Mono,Menlo,monospace"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto"/>
            </Grid>

        </Grid>
    </Grid>
</UserControl>
