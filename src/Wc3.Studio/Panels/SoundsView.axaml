<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:Wc3.Studio.Controls"
             x:Class="Wc3.Studio.Panels.SoundsView">
    <Grid RowDefinitions="*,4,*">
        <!-- Sound DEFINITIONS (war3map.w3s): named, playable sounds. -->
        <c:CatalogEditorView Name="Catalog" Grid.Row="0"
                             Title="Sound definitions (war3map.w3s)"
                             Subtitle="Named sounds that triggers and units can play. A map can hold thousands of audio files yet define no sounds - build definitions from the imported audio below."/>

        <GridSplitter Grid.Row="1" Height="4" HorizontalAlignment="Stretch"
                      Background="#33555555" ResizeDirection="Rows"/>

        <!-- Imported audio FILES (the archive assets, the WE Import Manager). -->
        <DockPanel Grid.Row="2">
            <Border DockPanel.Dock="Top" BorderBrush="#33555555" BorderThickness="0,1,0,1" Padding="8,6">
                <StackPanel Spacing="4">
                    <TextBlock Name="AudioTitle" FontWeight="SemiBold" Text="Imported audio"/>
                    <TextBlock FontSize="11" Foreground="#8FA3B8" TextWrapping="Wrap"
                               Text="The map's imported mp3/wav assets. 'Add as sound' creates a definition that references the file so it becomes playable by name."/>
                    <TextBox Name="AudioSearch" Watermark="Search imported audio (path or name)..."
                             TextChanged="OnAudioSearchChanged"/>
                </StackPanel>
            </Border>
            <TextBlock DockPanel.Dock="Bottom" Name="AudioStatus" Margin="8,4"
                       FontSize="11" Foreground="#8FA3B8" Text=""/>
            <ListBox Name="AudioList" Margin="8,4" Background="Transparent">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0" Text="{Binding}" FontSize="11"
                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                       ToolTip.Tip="{Binding}"/>
                            <Button Grid.Column="1" Content="Add as sound" Padding="8,2"
                                    Click="OnAddFromFile" VerticalAlignment="Center"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>
    </Grid>
</UserControl>
