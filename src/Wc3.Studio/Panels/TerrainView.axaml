<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Wc3.Studio.Panels.TerrainView">
    <DockPanel>

        <!-- Caption bar: image dimensions, zoom level, fit/reset -->
        <Border DockPanel.Dock="Top" BorderThickness="0,0,0,1"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                Padding="8,4">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Name="FitButton" Content="Fit" IsEnabled="False" Click="OnFitClick"/>
                <Button Name="ResetButton" Content="1:1" IsEnabled="False" Click="OnResetClick"/>
                <TextBlock Name="CaptionText" VerticalAlignment="Center" Text=""/>
            </StackPanel>
        </Border>

        <!-- Viewport: rendered terrain with scroll + wheel zoom -->
        <Grid>
            <ScrollViewer Name="ScrollHost"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto">
                <Image Name="TerrainImage" Stretch="Fill"
                       HorizontalAlignment="Left" VerticalAlignment="Top"/>
            </ScrollViewer>
            <TextBlock Name="MessageText"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       TextWrapping="Wrap" Text="No map loaded."/>
        </Grid>

    </DockPanel>
</UserControl>
