<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:Wc3.Studio.Controls"
             x:Class="Wc3.Studio.Panels.TriggerView">
    <UserControl.Styles>
        <!-- Compact rows in both the trigger tree and the ECA tree (same
             treatment as the Dependencies tree). -->
        <!-- Same compact toolbar treatment the terrain panel uses, so buttons across
             panels are one size rather than each panel's own. -->
        <Style Selector="WrapPanel#EditBar > Button">
            <Setter Property="Padding" Value="10,2"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="MinHeight" Value="26"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="WrapPanel#EcaBar > Button">
            <Setter Property="Padding" Value="10,2"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="MinHeight" Value="26"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="WrapPanel#EditBar > CheckBox">
            <Setter Property="Margin" Value="10,0,0,0"/>
        </Style>

        <Style Selector="TreeView TreeViewItem">
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Padding" Value="2,1"/>
        </Style>
    </UserControl.Styles>

    <Grid>
        <TextBlock Name="PlaceholderText"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   Text="Trigger panel, no map open"/>

        <Grid Name="ContentRoot" IsVisible="False" RowDefinitions="Auto,*">

            <!-- Header: counts, the map's script language, and the read-only notice. -->
            <Border Grid.Row="0" BorderThickness="0,0,0,1"
                    BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                    Padding="8,6">
                <StackPanel Spacing="2">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Name="HeaderText" FontWeight="SemiBold" Text="Triggers"/>
                        <TextBlock Name="LanguageText" Foreground="#8FA3B8"
                                   VerticalAlignment="Center" Text=""/>
                    </StackPanel>
                    <!-- Edit toolbar. One name box serves add-category, add-trigger and
                         rename, which keeps the panel free of modal dialogs (the app has
                         none anywhere else) and keeps the three verbs one click apart. -->
                    <WrapPanel Name="EditBar" Margin="0,4,0,0">
                        <TextBox Name="NameBox" Width="200" Height="26" FontSize="12"
                                 Watermark="name for add or rename…"/>
                        <Button Name="AddCategoryButton" Content="+ Category"
                                Click="OnAddCategoryClick"
                                ToolTip.Tip="Add a category, nested under the selected category"/>
                        <Button Name="AddTriggerButton" Content="+ Trigger" IsEnabled="False"
                                Click="OnAddTriggerClick"
                                ToolTip.Tip="Add a GUI trigger to the selected category"/>
                        <Button Name="RenameButton" Content="Rename" IsEnabled="False"
                                Click="OnRenameClick"/>
                        <Button Name="RemoveButton" Content="Remove" IsEnabled="False"
                                Click="OnRemoveClick"/>
                        <CheckBox Name="RecursiveCheck" Content="with children" FontSize="11"
                                  VerticalAlignment="Center"
                                  ToolTip.Tip="Remove a category's whole subtree instead of refusing to orphan it"/>
                    </WrapPanel>
                    <TextBlock Name="StatusText" FontSize="11" Foreground="#8FA3B8"
                               TextWrapping="Wrap" Margin="0,2,0,0" Text=""/>
                </StackPanel>
            </Border>

            <Grid Grid.Row="1" ColumnDefinitions="340,4,*">

                <!-- Left: World-Editor style tree, each category with its triggers
                     underneath, plus a Variables node. Items are built in
                     code-behind (the Dependencies panel's idiom). -->
                <Grid Grid.Column="0" RowDefinitions="Auto,*">
                    <controls:SectionHeader Grid.Row="0" Text="Trigger tree"/>
                    <TreeView Name="TriggerTree" Grid.Row="1" Margin="4"/>
                    <TextBlock Name="TreeHint" Grid.Row="1" IsVisible="False"
                               Margin="12" TextWrapping="Wrap" Foreground="#8FA3B8"
                               Text="This map has no triggers."/>
                </Grid>

                <GridSplitter Grid.Column="1" ResizeDirection="Columns" Background="#33555555"/>

                <!-- Right: the selected trigger's detail. GUI triggers show their
                     event/condition/action tree, custom-text triggers show their
                     script body in a read-only monospace box. -->
                <Grid Grid.Column="2" RowDefinitions="Auto,Auto,Auto,Auto,*">
                    <controls:SectionHeader Name="DetailHeader" Grid.Row="0" Text="Details"/>
                    <StackPanel Grid.Row="1" Margin="8,6,8,0" Spacing="4">
                        <TextBlock Name="FlagsText" FontSize="11" Foreground="#8FA3B8" Text=""/>
                        <!-- The three writable trigger flags. These edits existed in the
                             command layer, tested, and were reachable from no front-end at
                             all until now. A trigger that is disabled or initially off is a
                             common reason one looks correct and never fires, so being able
                             to see AND set them from the tree is the point. -->
                        <WrapPanel Name="FlagBar" IsVisible="False">
                            <CheckBox Name="EnabledCheck" Content="Enabled" FontSize="11"
                                      ToolTip.Tip="A disabled trigger is not compiled into the map script at all"/>
                            <CheckBox Name="InitiallyOnCheck" Content="Initially on" FontSize="11"
                                      Margin="12,0,0,0"
                                      ToolTip.Tip="A trigger that starts off never fires until something turns it on"/>
                            <CheckBox Name="MapInitCheck" Content="Run on map init" FontSize="11"
                                      Margin="12,0,0,0"/>
                        </WrapPanel>
                    </StackPanel>
                    <TextBlock Name="DescriptionText" Grid.Row="2" Margin="8,4,8,0"
                               TextWrapping="Wrap" IsVisible="False" Text=""/>
                    <!-- Authoring bar for the selected GUI trigger's events, conditions and
                         actions. The function name is typed rather than picked from a list of
                         677 actions, and the panel reports what the World-Editor table says
                         when the name is wrong, including near matches. -->
                    <WrapPanel Name="EcaBar" Grid.Row="3" Margin="8,6,8,0" IsVisible="False">
                        <ComboBox Name="EcaKindBox" Width="104" Height="26" FontSize="12"
                                  SelectedIndex="2">
                            <ComboBoxItem Content="Event"/>
                            <ComboBoxItem Content="Condition"/>
                            <ComboBoxItem Content="Action"/>
                        </ComboBox>
                        <TextBox Name="EcaNameBox" Width="200" Height="26" FontSize="12"
                                 Margin="6,0,0,0" Watermark="function, e.g. DisplayTextToForce"/>
                        <TextBox Name="EcaParamsBox" Width="180" Height="26" FontSize="12"
                                 Margin="6,0,0,0" Watermark="parameters, comma separated"
                                 ToolTip.Tip="In the order the function declares them. Leave any off to take the World-Editor default."/>
                        <Button Name="EcaAddButton" Content="Add" Click="OnAddEcaClick"/>
                        <Button Name="EcaRemoveButton" Content="Remove selected"
                                Click="OnRemoveEcaClick" IsEnabled="False"/>
                    </WrapPanel>

                    <Grid Grid.Row="4" Margin="4">
                        <TreeView Name="EcaTree" IsVisible="False"/>
                        <!-- A custom-text trigger's body IS JASS, so it gets the same editor
                             the Script panel uses, read-only. It was a bare monospace TextBox
                             with the default foreground, which is the other place the "white
                             text so it is terrible to eyes" complaint came from. Composing the
                             control rather than restyling the box means this pane gained line
                             numbers, highlighting and Ctrl+F for free. -->
                        <controls:JassEditorView Name="CustomScript" IsVisible="False"
                                                 IsReadOnly="True"/>
                        <TextBlock Name="DetailHint" Margin="8" TextWrapping="Wrap"
                                   Foreground="#8FA3B8" IsHitTestVisible="False"
                                   Text="Select a trigger to see its events, conditions and actions."/>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
